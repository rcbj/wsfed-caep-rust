{
  "about": [
    "This library's own AuthZEN table for the embedded Remote PEP (#40). Every case runs through",
    "RelyingParty::decide or decide_session with a Login and an Access. Offline, src/test_authzen.rs",
    "runs it in local mode against a stub PDP serving these rows and the XACML in",
    "src/test_authzen_policies.json (made from the ALFA below by iya-sts's own compiler:",
    "python3 scripts/live_authzen.py --compile). Live, scripts/live_authzen.py gives iya-sts the",
    "rows and the ALFA, and every case must answer the same in central and local mode, and as",
    "expected here. {{application}} is the application the PEP is bound to (the realm)."
  ],
  "claims": {
    "name": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
    "email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
    "role": "http://schemas.microsoft.com/ws/2008/06/identity/claims/role",
    "clearance": "http://schemas.example.org/claims/clearance",
    "verified": "http://schemas.example.org/claims/verified",
    "hired": "http://schemas.example.org/claims/hired",
    "department": "http://schemas.example.org/claims/department",
    "nickname": "http://schemas.example.org/claims/nickname"
  },
  "catalogue": [
    {"object": "subject", "property": "acr", "attributeId": "urn:example:wsfed:acr"},
    {"object": "subject", "property": "amr", "attributeId": "urn:example:wsfed:amr", "multiplicity": "bag"},
    {"object": "subject", "property": "auth_time", "attributeId": "urn:example:wsfed:auth-time", "category": "access-subject", "dataType": "integer"},
    {"object": "subject", "property": "emailaddress", "attributeId": "urn:example:wsfed:mail"},
    {"object": "subject", "property": "dept", "attributeId": "urn:example:wsfed:dept"},
    {"object": "subject", "property": "role", "attributeId": "urn:example:wsfed:groups", "multiplicity": "bag"},
    {"object": "subject", "property": "clearance", "attributeId": "urn:example:wsfed:clearance", "dataType": "integer"},
    {"object": "subject", "property": "verified", "attributeId": "urn:example:wsfed:verified", "dataType": "boolean"},
    {"object": "subject", "property": "hired", "attributeId": "urn:example:wsfed:hired", "dataType": "dateTime"},
    {"object": "resource", "property": "amount", "attributeId": "urn:example:wsfed:amount", "dataType": "double"},
    {"object": "resource", "property": "pages", "attributeId": "urn:example:wsfed:pages", "dataType": "http://www.w3.org/2001/XMLSchema#integer"},
    {"object": "resource", "property": "confidential", "attributeId": "urn:example:wsfed:confidential", "category": "resource", "dataType": "boolean"},
    {"object": "resource", "property": "owner.country", "attributeId": "urn:example:wsfed:owner-country"},
    {"object": "action", "property": "via", "attributeId": "urn:example:wsfed:via", "category": "action"},
    {"object": "context", "property": "channel", "attributeId": "urn:example:wsfed:channel", "category": "environment"},
    {"object": "context", "property": "device.trust", "attributeId": "urn:example:wsfed:device-trust", "category": "urn:oasis:names:tc:xacml:3.0:attribute-category:environment", "dataType": "double"},
    {"object": "context", "property": "requested_at", "attributeId": "urn:example:wsfed:requested-at", "dataType": "dateTime"}
  ],
  "directory": [
    {"username": "authzen-ada", "attributes": {"employeeType": "staff"}},
    {"username": "authzen-bo", "attributes": {"employeeType": "contractor"}}
  ],
  "policies": [
    {
      "name": "wsfedauthz-root",
      "role": "root",
      "phase": "root",
      "alfa": [
        "namespace wsfedauthz {",
        "    attribute act { category = actionCat id = \"urn:oasis:names:tc:xacml:1.0:action:action-id\" type = string }",
        "    attribute rtype { category = resourceCat id = \"urn:sts:xacml:authzen:resource-type\" type = string }",
        "    attribute protocol { category = environmentCat id = \"urn:sts:xacml:protocol\" type = string }",
        "    attribute app { category = environmentCat id = \"urn:sts:xacml:authzen:application\" type = string }",
        "    attribute acr { category = subjectCat id = \"urn:example:wsfed:acr\" type = string }",
        "    attribute amr { category = subjectCat id = \"urn:example:wsfed:amr\" type = string }",
        "    attribute authTime { category = subjectCat id = \"urn:example:wsfed:auth-time\" type = integer }",
        "    attribute dept { category = subjectCat id = \"urn:example:wsfed:dept\" type = string }",
        "    attribute groups { category = subjectCat id = \"urn:example:wsfed:groups\" type = string }",
        "    attribute clearance { category = subjectCat id = \"urn:example:wsfed:clearance\" type = integer }",
        "    attribute verified { category = subjectCat id = \"urn:example:wsfed:verified\" type = boolean }",
        "    attribute hired { category = subjectCat id = \"urn:example:wsfed:hired\" type = dateTime }",
        "    attribute staff { category = subjectCat id = \"employeeType\" type = string }",
        "    attribute amount { category = resourceCat id = \"urn:example:wsfed:amount\" type = double }",
        "    attribute pages { category = resourceCat id = \"urn:example:wsfed:pages\" type = integer }",
        "    attribute confidential { category = resourceCat id = \"urn:example:wsfed:confidential\" type = boolean }",
        "    attribute ownerCountry { category = resourceCat id = \"urn:example:wsfed:owner-country\" type = string }",
        "    attribute via { category = actionCat id = \"urn:example:wsfed:via\" type = string }",
        "    attribute channel { category = environmentCat id = \"urn:example:wsfed:channel\" type = string }",
        "    attribute deviceTrust { category = environmentCat id = \"urn:example:wsfed:device-trust\" type = double }",
        "    attribute requestedAt { category = environmentCat id = \"urn:example:wsfed:requested-at\" type = dateTime }",
        "    attribute caller { category = environmentCat id = \"urn:sts:xacml:authzen:caller\" type = string }",
        "    policy root {",
        "        id = \"urn:example:wsfedauthz:root\"",
        "        apply firstApplicable",
        "        target clause protocol == \"authzen\"",
        "        target clause app == \"{{application}}\"",
        "        target clause rtype == \"document\" or rtype == \"ledger\" or rtype == \"profile\"",
        "        rule readDocument {",
        "            permit",
        "            target clause act == \"read\" and rtype == \"document\"",
        "            condition integerGreaterThan(stringBagSize(acr), 0)",
        "        }",
        "        rule editDocument {",
        "            permit",
        "            target clause act == \"edit\" and rtype == \"document\"",
        "            condition stringIsIn(\"editors\", groups) && anyOf(integerLessThanOrEqual, 2, clearance)",
        "        }",
        "        rule signDocument {",
        "            permit",
        "            target clause act == \"sign\" and rtype == \"document\"",
        "            condition anyOf(booleanEqual, true, verified) && anyOf(integerLessThanOrEqual, 1700000000, authTime) && anyOf(dateTimeGreaterThan, dateTime(\"2025-01-01T00:00:00Z\"), hired)",
        "        }",
        "        rule stampDocument {",
        "            permit",
        "            target clause act == \"stamp\" and rtype == \"document\"",
        "            condition stringIsIn(\"urn:example:otp\", amr)",
        "            on permit {",
        "                obligation \"urn:sts:xacml:obligation:log\" { \"message\" = \"stamped\" }",
        "            }",
        "        }",
        "        rule reviewDocument {",
        "            permit",
        "            target clause act == \"review\" and rtype == \"document\"",
        "            condition stringIsIn(\"finance\", dept)",
        "        }",
        "        rule printDocument {",
        "            permit",
        "            target clause act == \"print\" and rtype == \"document\"",
        "            condition anyOf(integerGreaterThanOrEqual, 50, pages) && anyOf(booleanEqual, false, confidential)",
        "        }",
        "        rule archiveDocument {",
        "            permit",
        "            target clause act == \"archive\" and rtype == \"document\"",
        "            condition stringIsIn(\"batch\", via)",
        "        }",
        "        rule approveLedger {",
        "            permit",
        "            target clause act == \"approve\" and rtype == \"ledger\"",
        "            condition anyOf(doubleGreaterThanOrEqual, 5000.0, amount)",
        "            on permit {",
        "                obligation \"urn:sts:xacml:authzen:obligation:step-up\" { \"acr_value\" = \"urn:example:wsfed:mfa\" }",
        "            }",
        "        }",
        "        rule closeLedger {",
        "            permit",
        "            target clause act == \"close\" and rtype == \"ledger\"",
        "            on permit {",
        "                obligation \"urn:sts:xacml:authzen:obligation:notification\" { \"to\" = \"auditors@example.test\" \"body\" = \"a ledger was closed\" }",
        "            }",
        "        }",
        "        rule exportLedger {",
        "            permit",
        "            target clause act == \"export\" and rtype == \"ledger\"",
        "            target clause channel == \"intranet\"",
        "            condition anyOf(doubleLessThanOrEqual, 0.8, deviceTrust) && stringIsIn(\"NZ\", ownerCountry) && anyOf(dateTimeLessThanOrEqual, dateTime(\"2026-01-01T00:00:00Z\"), requestedAt)",
        "        }",
        "        rule inspectDocument {",
        "            permit",
        "            target clause act == \"inspect\" and rtype == \"document\"",
        "            condition anyOf(stringRegexpMatch, \"uid=pep-wsfed-authzen(-central|-local)?,ou=users,dc=.+\", caller)",
        "        }",
        "        rule readProfile {",
        "            permit",
        "            target clause act == \"read\" and rtype == \"profile\"",
        "            target clause staff == \"staff\"",
        "        }",
        "        rule otherwise {",
        "            deny",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "name": "wsfedauthz-shared",
      "role": "referenced",
      "phase": "application",
      "alfa": [
        "namespace wsfedshared {",
        "    attribute act { category = actionCat id = \"urn:oasis:names:tc:xacml:1.0:action:action-id\" type = string }",
        "    attribute rtype { category = resourceCat id = \"urn:sts:xacml:authzen:resource-type\" type = string }",
        "    attribute acr { category = subjectCat id = \"urn:example:wsfed:acr\" type = string }",
        "    policy shared {",
        "        id = \"urn:example:wsfedauthz:shared\"",
        "        apply denyUnlessPermit",
        "        rule readReport {",
        "            permit",
        "            target clause act == \"read\" and rtype == \"report\"",
        "            condition integerGreaterThan(stringBagSize(acr), 0)",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "name": "{{application-policy}}",
      "role": "application",
      "phase": "application",
      "references": ["urn:example:wsfedauthz:shared"],
      "alfa": [
        "namespace wsfedapp {",
        "    attribute act { category = actionCat id = \"urn:oasis:names:tc:xacml:1.0:action:action-id\" type = string }",
        "    attribute stage { category = environmentCat id = \"urn:sts:xacml:fga:stage\" type = string }",
        "    attribute fgaApp { category = resourceCat id = \"urn:sts:xacml:fga:application\" type = string }",
        "    policyset application {",
        "        id = \"urn:example:wsfedauthz:application\"",
        "        apply firstApplicable",
        "        target clause stage == \"access\"",
        "        target clause fgaApp == \"{{application}}\"",
        "        policy noPurge {",
        "            id = \"urn:example:wsfedauthz:no-purge\"",
        "            apply firstApplicable",
        "            rule purge {",
        "                deny",
        "                target clause act == \"purge\"",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    }
  ],
